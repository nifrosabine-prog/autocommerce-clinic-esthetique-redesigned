# Copier ce fichier vers /etc/autocommerce/offsite.env sur le VPS
# (chmod 600, racine uniquement) — jamais commité, jamais dans une archive.
# Toutes les variables sont aussi passables par environnement (cron/systemd).

# ── Cible rsync (SSH par clé — jamais de mot de passe) ──
# Format : [user@]hote:/chemin/absolu   (le slash final est ajouté par le script)
OFFSITE_TARGET=backup@nas.local:/volume/autocommerce

# ── Sources ──
# Par défaut : volumes Docker `clinic_backups` + `clinic_data` détectés
# automatiquement via `docker volume inspect`.
# Décommenter pour forcer des chemins (tests, déploiement non-Docker) :
# OFFSITE_SOURCES=/var/lib/docker/volumes/clinic_backups/_data /var/lib/docker/volumes/clinic_data/_data

# ── Rétention ──
# Cohérent avec RETENTION_DAYS de backup.sh : le miroir distant reflète la
# purge locale grâce à `--delete`. Ne pas baisser au-dessous de la rétention locale.
OFFSITE_HISTORY_DAYS=14

# ── Exclusions supplémentaires (séparées par des virgules) ──
# OFFSITE_EXCLUDE_EXTRA=*.part,*.swp

# ── Alerte en cas d'échec (webhook générique Slack/Discord, optionnel) ──
# OFFSITE_WEBHOOK_URL=https://hooks.exemple.tld/....

# ── Journal et verrou (défauts OK, ajustables) ──
# OFFSITE_LOG=/var/log/autocommerce_offsite.log
# OFFSITE_LOCKFILE=/var/lock/autocommerce_offsite.lock
# OFFSITE_CONFIG=/etc/autocommerce/offsite.env
