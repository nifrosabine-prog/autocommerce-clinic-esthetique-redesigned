{$DOMAIN} {
	encode gzip

	# Sécurité transport — complète les en-têtes déjà posés par nginx côté web.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	reverse_proxy web:8080
}

# Redirection explicite si un accès HTTP direct arrive malgré tout
# (Caddy gère déjà le 80->443 pour le domaine ci-dessus ; ce bloc couvre
# les requêtes qui arrivent avec une autre Host: sur le port 80).
:80 {
	redir https://{$DOMAIN}{uri} permanent
}
