# Copier ce fichier vers deploy/production.env puis remplacer chaque valeur.
# Ne jamais committer deploy/production.env (ni le livrer dans une archive).
APP_NAME=AutoCommerce Clinic
ENV=production
CLINIC_ID=1
PUBLIC_CLINIC_ID=1
PUBLIC_ROUTES_ENABLED=true
IS_INTERNAL_SINGLE_CLINIC=true

# Domaine réel pointant vers ce VPS (DNS A/AAAA déjà configuré) — utilisé
# par Caddy pour obtenir automatiquement un certificat Let's Encrypt.
# CORS_ORIGINS doit correspondre exactement (schéma https, même domaine).
DOMAIN=REMPLACER_PAR_VOTRE_DOMAINE_ex_clinic.exemple.tld
CORS_ORIGINS=https://REMPLACER_PAR_VOTRE_DOMAINE_ex_clinic.exemple.tld

# Identifiants PostgreSQL utilisés par Docker Compose.
POSTGRES_DB=clinic_production
POSTGRES_USER=clinic_app
POSTGRES_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_POSTGRES_FORT
WEB_PORT=8080

# Sauvegardes automatiques (service "backup") : intervalle en secondes
# entre deux pg_dump et durée de rétention en jours.
BACKUP_INTERVAL_SECONDS=86400
RETENTION_DAYS=14

# PostgreSQL et Redis sont injectés par docker-compose.production.yml.
# DATABASE_URL et REDIS_URL ne doivent pas être placées ici avec des placeholders.

# Générer trois clés distinctes d’au moins 64 caractères.
# Correctif AUD-001 (2026-09-11) : FERNET_KEY, PHOTO_ENCRYPTION_KEY et
# MFA_ENCRYPTION_KEY doivent être de VRAIES clés Fernet — 32 octets encodés
# en base64 url-safe (44 caractères, padding '=' inclus), sans guillemets.
# Une clé mal formée fait échouer la création du dossier médical avec
# « Fernet key must be 32 url-safe base64-encoded bytes ». L'application
# refuse désormais de démarrer en production avec une clé invalide.
# Générer chaque clé avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (générer 3 fois — jamais la même clé pour les trois variables).
SECRET_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE_DE_64_CARACTERES_MINIMUM
FERNET_KEY=REMPLACER_PAR_UNE_CLE_FERNET_BASE64_URLSAFE
PHOTO_ENCRYPTION_KEY=REMPLACER_PAR_UNE_AUTRE_CLE_FERNET_BASE64_URLSAFE
MFA_ENCRYPTION_KEY=REMPLACER_PAR_UNE_TROISIEME_CLE_FERNET_BASE64_URLSAFE
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax

# Valeurs métier minimales pour un démarrage sans intégration externe.
LLM_ENABLED=false
MEDICAL_AI_PROVIDER_APPROVED=false
WHATSAPP_ENABLED=false
WA_ALLOW_DEV_MODE=false
ALLOWED_EXTERNAL_INTEGRATIONS=

# Correctif AUD-003 (2026-09-11) : positionner à true UNIQUEMENT sur le VPS
# de RECETTE pour que le conteneur api restaure les dix actes de recette au
# démarrage (idempotent — ne modifie jamais un acte existant). Laisser
# commenté/false en production réelle.
# SEED_ACTES_RECETTE=true

# Amorçage facultatif du compte directrice : fournir hors dépôt puis supprimer après usage.
# BOOTSTRAP_ADMIN_EMAIL=admin@votre-domaine.tld
# BOOTSTRAP_ADMIN_PASSWORD=mot-de-passe-fort-unique
